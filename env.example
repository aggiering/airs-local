# Copy to .env and fill in (chmod 600 .env). The same values as airs-kagent's .env.
MCP_URL=
IDIRA_CLIENT_ID=
IDIRA_CLIENT_SECRET=
# Space-separated; may be empty.
IDIRA_SCOPES=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Must be registered with the IdP for IDIRA_CLIENT_ID. The listener binds to its
# host and port; set OAUTH_CALLBACK_HOST/PORT if a proxy forwards it elsewhere.
# OAUTH_REDIRECT_URI=http://localhost:8765/callback
# Where tokens are saved (encrypted), default .airs-tokens next to the script.
# TOKEN_DIR=
# Seconds to wait for the browser sign-in, default 300.
# OAUTH_FLOW_TIMEOUT=300
